{
  "name": "@unocss-applet/monorepo",
  "type": "module",
  "version": "0.14.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "pnpm -r --filter='./packages/*' --parallel run dev",
    "build": "pnpm -r --filter='./packages/*' run build && pnpm -r run build-post",
    "release": "bumpp package.json packages/**/package.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest",
    "test:update": "vitest -u",
    "play:uni:mp-weixin": "pnpm -C examples/uni-app run dev:mp-weixin",
    "build:uni:mp-weixin": "pnpm -C examples/uni-app run build:mp-weixin",
    "play:uni:h5": "pnpm -C examples/uni-app run dev:h5",
    "build:uni:h5": "pnpm -C examples/uni-app run build:h5",
    "play:taro:weapp": "pnpm -C examples/taro run dev:weapp",
    "build:taro:weapp": "pnpm -C examples/taro run build:weapp",
    "play:taro:h5": "pnpm -C examples/taro run dev:h5",
    "build:taro:h5": "pnpm -C examples/taro run build:h5",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "concurrently": "catalog:utils"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:eslint",
    "@iconify-json/tabler": "catalog:icons",
    "@types/node": "catalog:types",
    "@unocss-applet/preset-applet": "workspace:*",
    "@unocss-applet/preset-rem-rpx": "workspace:*",
    "@unocss-applet/reset": "workspace:*",
    "@unocss-applet/shared": "workspace:*",
    "@unocss-applet/transformer-attributify": "workspace:*",
    "@unocss-applet/transformer-hover": "workspace:*",
    "@unocss/core": "catalog:unocss",
    "@unocss/eslint-config": "catalog:unocss",
    "@unocss/preset-attributify": "catalog:unocss",
    "@unocss/preset-icons": "catalog:unocss",
    "@unocss/preset-wind3": "catalog:unocss",
    "bumpp": "catalog:utils",
    "eslint": "catalog:eslint",
    "magic-string": "catalog:utils",
    "tsdown": "catalog:utils",
    "typescript": "catalog:typescript",
    "unocss": "catalog:unocss",
    "unocss-applet": "workspace:*",
    "vite": "catalog:vite",
    "vitest": "catalog:vite"
  }
}
